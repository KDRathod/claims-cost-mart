# Copy to .env (git-ignored). Never commit real values.
DBT_TARGET=duckdb                # duckdb (local, free) or snowflake

# Only needed when DBT_TARGET=snowflake
SNOWFLAKE_ACCOUNT=               # <orgname>-<account_name>
SNOWFLAKE_USER=CLAIMS_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=      # path to the service user's .p8 key, kept outside this repo
SNOWFLAKE_ROLE=CLAIMS_TRANSFORMER
SNOWFLAKE_WAREHOUSE=CLAIMS_WH
SNOWFLAKE_DATABASE=CLAIMS
